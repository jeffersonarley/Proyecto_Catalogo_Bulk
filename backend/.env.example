PORT=3000
# MongoDB Atlas (reemplaza <usuario> y <db_password> por tus credenciales reales)
MONGO_URI=mongodb+srv://<usuario>:<db_password>@<cluster>.mongodb.net/ClausterCatalogoDB?retryWrites=true&w=majority
# Redis NO está en Atlas: usa localhost (desarrollo) o el servicio `redis` (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=cambiar_en_produccion
JWT_EXPIRES_IN=1h
MAX_FILE_SIZE_MB=50
BATCH_SIZE=500
CACHE_TTL_SECONDS=300
IMPORT_ERRORS_CAP=1000

# Con Docker Compose, `redis` es el nombre del servicio.
# MongoDB Atlas es externo: el valor de MONGO_URI es el mismo dentro o fuera de Docker.
